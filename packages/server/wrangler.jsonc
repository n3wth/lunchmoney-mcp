{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lunchmoney-mcp-staging",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "analytics_engine_datasets": [{ "binding": "TELEMETRY", "dataset": "lunchmoney_mcp_staging" }],
  "d1_databases": [{
    "binding": "IDENTITY_DB",
    "database_name": "lunchmoney-mcp-staging-identity",
    "database_id": "8ad2effa-96bf-40b3-b596-671a7222ca31",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "NANGO_ENVIRONMENT": "dev",
    "LM_AUTH_ISSUER": "https://newth.us.auth0.com/",
    "LM_AUTH_RESOURCE": "https://mcp-staging.lunchmoney.sh/mcp",
    "LM_AUTH_JWKS_URI": "https://newth.us.auth0.com/.well-known/jwks.json",
    "LM_METADATA_URL": "https://mcp-staging.lunchmoney.sh/.well-known/oauth-protected-resource",
    "LM_ENV": "development"
  }
}
