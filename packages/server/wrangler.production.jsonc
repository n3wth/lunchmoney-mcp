{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lunchmoney-mcp-production",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "analytics_engine_datasets": [{ "binding": "TELEMETRY", "dataset": "lunchmoney_mcp_production" }],
  "d1_databases": [{
    "binding": "IDENTITY_DB",
    "database_name": "lunchmoney-mcp-production-identity",
    "database_id": "b3f05c40-2e28-4e3b-93cf-4f44cb79c162",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "NANGO_ENVIRONMENT": "prod",
    "LM_AUTH_ISSUER": "https://newth.us.auth0.com/",
    "LM_AUTH_RESOURCE": "https://mcp.lunchmoney.sh/mcp",
    "LM_AUTH_JWKS_URI": "https://newth.us.auth0.com/.well-known/jwks.json",
    "LM_METADATA_URL": "https://mcp.lunchmoney.sh/.well-known/oauth-protected-resource",
    "LM_ENV": "production"
  }
}
